def createSpiral(N):
    if not isinstance(N, int) or N < 1:
        return []
    
    # Make an empty N x N grid
    spiral = [[0]*N for _ in range(N)]
    
    num = 1
    top, bottom, left, right = 0, N-1, 0, N-1
    
    while num <= N*N:
        # Fill top row
        for i in range(left, right+1):
            spiral[top][i] = num
            num += 1
        top += 1
        
        # Fill right column
        for i in range(top, bottom+1):
            spiral[i][right] = num
            num += 1
        right -= 1
        
        # Fill bottom row
        for i in range(right, left-1, -1):
            spiral[bottom][i] = num
            num += 1
        bottom -= 1
        
        # Fill left column
        for i in range(bottom, top-1, -1):
            spiral[i][left] = num
            num += 1
        left += 1
    
    return spiral
