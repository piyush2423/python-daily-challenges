        if i < 40:
            failed += 1
        else:
            passed +=1
    avrage = sum(all)/len(all)
    hpercent = max(all)
    print("Highest percentage is: ", hpercent)
    print("Average percentage is: ", avrage)
    print("Students passed: ", passed)
    print("Student failed: ", failed)
    
