percentages = []
def calculation(marks):
    lcount = 0
    hcount = 0
    for x in marks:
        if x >= 75:
            hcount += 1
        elif x < 40:
            lcount +=1
    total = sum(marks)
    avrage = total/len(marks)
    High = max(marks)
    low = min(marks)
    print("Total marks of this student: ", total)
    print("Average marks of this student: ", avrage)
    print("Hightest marks of this student: ", High)
    print("Lowest marks of this student: ", low)
    percent = (total/500)*100
    percentages.append(percent)
    print("------------------------------------------------")
    print("You scored", percent, '%')
    print("------------------------------------------------")
    if percent < 40 or lcount > 0:
        print("Grade obtained: F")
    elif percent >= 90:
        print("Grade obtained: A+")
    elif percent >= 80:
        print("Grade obtained: A")
    elif percent >= 70:
        print("Grade obtained: B")
    elif percent >= 60:
        print("Grade obtained: C")
    elif percent >= 40:
        print("Grade obtained: D")
        
    print("------------------------------------------------")
    if max(marks)>74:
        print("In", hcount, "subjects you scored 75 or above marks")
        
    if percent > 85:
        print("You are eligible for merit certificate")
        
def classcalculation(all):
