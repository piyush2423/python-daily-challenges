def is_prime(n: int) -> bool:
    # Primes are greater than 1
    if n <= 1:
        return False
    
    # 2 and 3 are prime
    if n <= 3:
        return True
    
    # Eliminate even numbers and multiples of 3
    if n % 2 == 0 or n % 3 == 0:
        return False
    
    # Check divisors up to sqrt(n)
    i = 5
    while i * i <= n:
        if n % i == 0 or n % (i + 2) == 0:
            return False
        i += 6
    
    return True
